{
  "name": "@phoenix-assets/svelte",
  "version": "1.2.1",
  "description": "Typed Electric, PubSub, localization, and portable reporting helpers for phoenix_assets on Svelte 5.",
  "author": "Tobias Bohwalli <hi@futhr.io>",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ghostshift-assembly/phoenix-assets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostshift-assembly/phoenix-assets.git",
    "directory": "npm/svelte"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./socket": {
      "types": "./dist/socket.d.ts",
      "import": "./dist/socket.js"
    },
    "./collection": {
      "types": "./dist/collection.d.ts",
      "svelte": "./dist/collection.js",
      "import": "./dist/collection.js"
    },
    "./reporting": {
      "types": "./dist/reporting/index.d.ts",
      "svelte": "./dist/reporting/index.js",
      "import": "./dist/reporting/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --coverage",
    "check:publish": "publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error -q"
  },
  "peerDependencies": {
    "@electric-sql/client": "^1.5.27",
    "@tanstack/electric-db-collection": "^0.6.3",
    "@tanstack/svelte-db": "^0.5.12",
    "phoenix": "^1.7.0",
    "svelte": "^5.7.0",
    "layerchart": "2.9.1"
  },
  "peerDependenciesMeta": {
    "@electric-sql/client": {
      "optional": true
    },
    "@tanstack/electric-db-collection": {
      "optional": true
    },
    "@tanstack/svelte-db": {
      "optional": true
    },
    "phoenix": {
      "optional": true
    },
    "layerchart": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/client": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tanstack/electric-db-collection": "catalog:",
    "@tanstack/svelte-db": "catalog:",
    "@types/phoenix": "^1.6.8",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "phoenix": "^1.8.16",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "layerchart": "2.9.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
