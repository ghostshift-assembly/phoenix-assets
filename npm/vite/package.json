{
  "name": "@phoenix-assets/vite",
  "version": "3.0.0",
  "description": "Vite plugin for phoenix_assets: $phoenix/* virtual modules, the generated-contracts HMR bridge, a PO loader, and the asset-graph emitter.",
  "author": "Tobias Bohwalli <hi@futhr.io>",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ghostshift-assembly/phoenix-assets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostshift-assembly/phoenix-assets.git",
    "directory": "npm/vite"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check:publish": "publint && attw --pack . --profile esm-only -q"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
