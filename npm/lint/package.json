{
  "name": "@phoenix-assets/lint",
  "version": "1.1.1",
  "description": "Shared Biome, Svelte 5 structure, and Tailwind v4 lint tooling for phoenix_assets host apps.",
  "author": "Tobias Bohwalli <hi@futhr.io>",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ghostshift-assembly/phoenix-assets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostshift-assembly/phoenix-assets.git",
    "directory": "npm/lint"
  },
  "files": [
    "biome.base.json",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "phoenix-assets-lint-svelte": "./dist/lint-svelte.js",
    "phoenix-assets-lint-tailwind": "./dist/lint-tailwind.js"
  },
  "exports": {
    "./biome.base.json": "./biome.base.json",
    "./lint-svelte.js": "./dist/lint-svelte.js",
    "./lint-tailwind.js": "./dist/lint-tailwind.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:publish": "publint"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.4.0",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
