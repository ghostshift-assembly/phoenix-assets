{
  "name": "@phoenix-assets/doc-shell",
  "version": "1.2.1",
  "description": "Renderer-neutral Svelte documentation shell for DocShell artifacts.",
  "author": "Tobias Bohwalli <hi@futhr.io>",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ghostshift-assembly/phoenix-assets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostshift-assembly/phoenix-assets.git",
    "directory": "npm/doc-shell"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "build:browser": "node scripts/build-browser.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --coverage",
    "check:offline": "node scripts/check-offline.mjs",
    "check:stories": "node scripts/check-stories.mjs",
    "check:publish": "publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error no-resolution -q"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  },
  "dependencies": {
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "mermaid": "^12.2.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@storybook/svelte-vite": "10.6.3",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "pagefind": "1.5.2",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
