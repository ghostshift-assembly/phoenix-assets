{
  "name": "@phoenix-assets/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "description": "Monorepo for the phoenix_assets npm packages.",
  "scripts": {
    "build": "pnpm -r build",
    "build:doc-shell-assets": "pnpm --filter @phoenix-assets/doc-shell build:browser",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write --unsafe .",
    "knip": "knip",
    "qualify:artifacts": "node scripts/artifact-qualification.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:svelte-filenames": "node scripts/check-svelte-filenames.mjs",
    "check:exports": "pnpm -r build && pnpm -r run check:publish",
    "check:release": "node scripts/release.mjs check --allow-untagged",
    "test:release": "node scripts/reporting-profile.mjs --check && node --test scripts/release.test.mjs",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "1.64.1",
    "knip": "^6.42.1",
    "publint": "^0.3.25",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
