# Elixir build artifacts
/_build/
/deps/
/.elixir_ls/
/cover/
/doc/
*.beam
*.ez
erl_crash.dump

# JavaScript
node_modules/
storybook-static/
/npm/*/dist/
/npm/*/coverage/
/dist/release/
/npm/*/.svelte-kit/
/priv/doc_shell/
*.tsbuildinfo

# AI agents
/.claude/
/.codex/

# CI source checkouts
/.candidates/

# SvelteKit (adapter-static) build output -- hashed, never committed; appears
# when an integration/install test scaffolds an app that builds into priv/static.
priv/static/_app/immutable/

# Dialyzer PLTs -- moved out of _build so CI can cache the core PLT on the
# toolchain alone rather than on mix.lock.
/priv/plts/

# Editors / OS
.DS_Store
*.iml
